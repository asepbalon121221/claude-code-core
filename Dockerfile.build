# Build + smoke on Linux (glibc). Auth via build-args / env only — never bake secrets.
FROM oven/bun:1.3-debian AS build
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ripgrep ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY package.json bun.lock* tsconfig.json ./
COPY scripts ./scripts
COPY src ./src
COPY assets ./assets
RUN bun install --frozen-lockfile || bun install
RUN bun run build:linux-x64

FROM debian:bookworm-slim AS smoke
RUN apt-get update && apt-get install -y --no-install-recommends ripgrep ca-certificates bash \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/dist/claude /app/dist/claude
COPY scripts/smoke-linux.sh /app/scripts/smoke-linux.sh
ENV USE_BUILTIN_RIPGREP=0
ENTRYPOINT ["bash", "/app/scripts/smoke-linux.sh"]
