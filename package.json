{
  "name": "claude-code-core",
  "version": "0.1.0-core",
  "private": true,
  "type": "module",
  "description": "Core Claude Code Linux x64 rebuild from source dump (external feature set)",
  "bin": {
    "claude": "./dist/claude"
  },
  "engines": {
    "bun": ">=1.2.23",
    "node": ">=22.0.0"
  },
  "scripts": {
    "check:imports": "bun run scripts/check-imports.ts",
    "check:router": "bun run src/utils/routerDefaults.check.ts",
    "check:router:live": "bun -e \"process.env.ROUTER_LIVE_CHECK='1'; await import('./src/utils/routerDefaults.check.ts')\"",
    "check:secrets": "bun run scripts/check-secrets.ts",
    "generate:stubs": "bun run scripts/generate-stubs.ts",
    "build:js": "bun run generate:stubs && bun run scripts/build.ts --js",
    "build:linux-x64": "bun run generate:stubs && bun run scripts/build.ts --linux-x64",
    "smoke:linux": "bash scripts/smoke-linux.sh",
    "build": "bun run build:linux-x64"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "^0.1.3",
    "@anthropic-ai/sandbox-runtime": "^0.0.16",
    "@anthropic-ai/sdk": "^0.52.0",
    "@commander-js/extra-typings": "^13.1.0",
    "@growthbook/growthbook": "^1.4.1",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "ajv": "^8.17.1",
    "asciichart": "^1.5.25",
    "auto-bind": "^5.0.1",
    "axios": "^1.9.0",
    "bidi-js": "^1.0.3",
    "cacache": "^19.0.1",
    "chalk": "^5.4.1",
    "chokidar": "^4.0.3",
    "cli-boxes": "^3.0.0",
    "cli-highlight": "^2.1.11",
    "code-excerpt": "^4.0.0",
    "commander": "^13.1.0",
    "diff": "^7.0.0",
    "emoji-regex": "^10.4.0",
    "env-paths": "^3.0.0",
    "execa": "^9.5.2",
    "fflate": "^0.8.2",
    "figures": "^6.1.0",
    "fuse.js": "^7.1.0",
    "get-east-asian-width": "^1.3.0",
    "highlight.js": "^11.11.1",
    "https-proxy-agent": "^7.0.6",
    "ignore": "^7.0.4",
    "indent-string": "^5.0.0",
    "jsonc-parser": "^3.3.1",
    "lodash-es": "^4.17.21",
    "lru-cache": "^11.1.0",
    "marked": "^15.0.11",
    "p-map": "^7.0.3",
    "picomatch": "^4.0.2",
    "proper-lockfile": "^4.1.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-reconciler": "^0.32.0",
    "semver": "^7.7.2",
    "shell-quote": "^1.8.2",
    "signal-exit": "^4.1.0",
    "stack-utils": "^2.0.6",
    "strip-ansi": "^7.1.0",
    "supports-hyperlinks": "^3.2.0",
    "tree-kill": "^1.2.2",
    "turndown": "^7.2.0",
    "undici": "^7.8.0",
    "usehooks-ts": "^3.1.1",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-types": "^3.17.5",
    "wrap-ansi": "^9.0.0",
    "ws": "^8.18.1",
    "xss": "^1.0.15",
    "yaml": "^2.7.1",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-reconciler": "^0.28.3",
    "@types/semver": "^7.7.0",
    "@types/shell-quote": "^1.7.5",
    "@types/ws": "^8.18.1",
    "bun-types": "^1.2.23",
    "type-fest": "^4.40.1",
    "typescript": "^5.8.3"
  }
}
